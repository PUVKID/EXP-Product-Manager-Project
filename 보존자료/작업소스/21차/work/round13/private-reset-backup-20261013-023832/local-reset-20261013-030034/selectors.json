{
  "Version": 3,
  "HomeUrl": "https://m.bunjang.co.kr/",
  "NewProductUrl": "https://m.bunjang.co.kr/products/new",
  "ManageUrl": "https://m.bunjang.co.kr/products/manage?tab=ALL&size=10&page={0}",
  "ProductUrl": "https://m.bunjang.co.kr/products/{0}",
  "LoggedInXPath": "//button[@aria-label='알림']",
  "LoginOpenXPath": "//*[self::a or self::button][contains(normalize-space(.),'로그인')]",
  "LoginIdXPath": "//input[contains(@placeholder,'아이디') or contains(@placeholder,'이메일') or contains(@placeholder,'휴대폰') or @type='email' or @type='tel']",
  "LoginPwXPath": "//input[@type='password']",
  "LoginSubmitXPath": "//button[contains(normalize-space(.),'로그인')]",
  "ImageInputXPath": "//input[@id='media-input']",
  "TitleXPath": "//input[@name='common.name'][not(contains(@placeholder,'검색')) and not(@type='search')]",
  "CategoryOpenXPath": "",
  "CategoryItemXPath": "//*[@id='scroll-categoryId']//li[normalize-space(.)='{0}']",
  "ConditionOpenXPath": "//*[@id='scroll-condition']//button[@aria-haspopup='listbox']",
  "ConditionOptionXPath": "//*[@role='option' or self::li][contains(translate(normalize-space(.),' ',''),'{0}')]",
  "DescriptionXPath": "//*[@id='scroll-description']//textarea",
  "TagXPath": "//input[contains(@placeholder,'태그')]",
  "PriceXPath": "//*[@id='scroll-price']//input[@inputmode='numeric']",
  "ShippingOpenXPath": "//button[@aria-haspopup='listbox'][.//span[contains(normalize-space(.),'배송비')]]",
  "ShippingOptionXPath": "//*[@role='option' or self::li][contains(translate(normalize-space(.),' ',''),'{0}')]",
  "QuantityXPath": "//*[@id='scroll-quantity']//input",
  "SubmitXPath": "//button[@type='submit' and normalize-space(.)='등록하기']",
  "ProductIdRegex": "/products/(\\d+)",
  "RowXPath": "//*[@role='row'][.//input[@type='checkbox' and not(@id='header-checkbox')]]",
  "RowLinkXPath": ".//a[contains(@href,'/products/')]",
  "RowTitleXPath": ".//a[contains(@href,'/products/')]/span",
  "DialogConfirmXPath": "//button[normalize-space(.)='삭제' or normalize-space(.)='확인' or normalize-space(.)='끌어올리기']",
  "NextPageXPath": "//button[@aria-label='다음 페이지' and not(@disabled)]"
}
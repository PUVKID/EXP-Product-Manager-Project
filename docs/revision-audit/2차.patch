+            Start();
+            if (string.IsNullOrEmpty(p.ProductId)) { Log.Write("  상품번호가 없어 삭제를 건너뜀: " + p.Title); return false; }
+            Log.Write("[삭제] " + p.Title + " (" + p.ProductId + ")");
+            try
+            {
+                bool found = false;
+                for (int page = 0; page < 50 && !found; page++)
+                {
+                    CheckStop();
+                    Go(string.Format(_sel.ManageUrl, page));
+                    Sleep(2500);
+                    var rows = SafeFind(_sel.RowXPath);

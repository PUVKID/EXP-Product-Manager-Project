+                    if (i >= cur.Count) break;
+                    var row = cur[i];
+                    string title = "";
+                    try { title = row.FindElement(By.XPath(_sel.RowTitleXPath)).Text.Trim(); } catch { }
+                    try
+                    {
+                        var btn = row.FindElements(By.XPath(_sel.RowBumpXPath)).FirstOrDefault();

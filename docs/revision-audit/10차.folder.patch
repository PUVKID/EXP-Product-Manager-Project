+            try
+            {
+                IEnumerable<Product> q = Host.Products;
+                string s = txtSearch.Text.Trim();
+                if (s.Length > 0) q = q.Where(p => Has(p.Title, s) || Has(p.Category, s) || Has(p.Tags, s) || Has(p.Description, s) || Has(p.Status, s) || Has(p.ProductId, s));

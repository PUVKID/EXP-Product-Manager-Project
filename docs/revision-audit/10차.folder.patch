+        private string CurrentShopId()
+        {
+            // Only the authenticated navigation's own-shop link, never an arbitrary seller
+            // on the page, a user-supplied account label, or a session-token fingerprint.
+            var ids = new HashSet<string>();
+            foreach (var link in _driver.FindElements(By.XPath("//a[contains(@href,'/shop/') and (contains(translate(normalize-space(.),' ',''),'내상점') or contains(@aria-label,'내 상점'))]")))
+            {
+                if (!link.Displayed) continue;
+                Uri url; if (!Uri.TryCreate(link.GetAttribute("href"), UriKind.Absolute, out url)) continue;
+                if (url.Host != "m.bunjang.co.kr" && url.Host != "bunjang.co.kr" && url.Host != "www.bunjang.co.kr") continue;
+                var match = Regex.Match(url.AbsolutePath, @"^/shop/(\d{1,20})(/|$)");
+                if (match.Success) ids.Add(match.Groups[1].Value);
+            }
+            if (ids.Count != 1) throw new InvalidOperationException("내 상점 정보를 확인할 수 없습니다. 번개장터 로그인 상태를 확인해 주세요. 계속되면 관리자에게 문의해 주세요.");
+            return ids.First();
+        }

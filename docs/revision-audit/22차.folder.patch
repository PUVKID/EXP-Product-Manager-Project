+            {
+                int v = p.Dark ? 1 : 0;
+                DwmSetWindowAttribute(f.Handle, DWMWA_USE_IMMERSIVE_DARK_MODE, ref v, 4);
+                int round = 2;   // DWMWCP_ROUND
+                DwmSetWindowAttribute(f.Handle, DWMWA_WINDOW_CORNER_PREFERENCE, ref round, 4);

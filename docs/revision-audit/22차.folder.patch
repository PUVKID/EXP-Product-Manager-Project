+            var time = now.TimeOfDay;
+            return start < end ? time >= TimeSpan.FromMinutes(start) && time < TimeSpan.FromMinutes(end)
+                : time >= TimeSpan.FromMinutes(start) || time < TimeSpan.FromMinutes(end);
+        }

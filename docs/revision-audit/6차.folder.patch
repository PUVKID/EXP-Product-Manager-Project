+@echo off
+rem ============================================================================
+rem  BunjangAuto 2.0  -  Windows 에서 직접 빌드 (Visual Studio / .NET SDK 불필요)
+rem  Windows 10/11 에 기본 포함된 .NET Framework 4.x 의 csc.exe 를 사용합니다.
+rem
+rem  중앙 로그 서버 주소/등록 키를 exe 안에 넣고 싶으면 빌드 전에 지정하세요:
+rem      set BJA_SERVER_URL=https://logs.example.com
+rem      set BJA_INGEST_KEY=서버의 data\ingest_keys.txt 에 있는 키
+rem      build.bat
+rem  (지정하지 않으면 비워 두고, 사용자 PC 의 %%AppData%%\BunjangAuto\telemetry.json 에서 설정)
+rem ============================================================================
+setlocal enabledelayedexpansion
+chcp 65001 >nul
+cd /d "%~dp0"
+set CSC=%WINDIR%\Microsoft.NET\Framework\v4.0.30319\csc.exe
+if not exist "%CSC%" (echo csc.exe 를 찾을 수 없습니다: %CSC% & goto :end)
+
+rem --- 서버 주소/키 주입
+> src\Telemetry\BuildConfig.cs echo namespace BunjangAuto { public static class BuildConfig { public const string ServerUrl = "%BJA_SERVER_URL%"; public const string IngestKey = "%BJA_INGEST_KEY%"; } }
+
+set REFS=
+set RES=
+for %%f in (lib\*.dll) do (
+  set REFS=!REFS! /r:%%f
+  set RES=!RES! /resource:%%f,lib.%%~nf.dll
+)
+for %%f in (resources\help\*.md) do (
+  set RES=!RES! /resource:%%f,help.%%~nxf
+)
+set SRC=
+for /r src %%f in (*.cs) do set SRC=!SRC! "%%f"
+if not exist dist mkdir dist
+"%CSC%" /target:winexe /optimize+ /platform:anycpu /nowarn:1701,1702,0618,0168,0219,0414,0649,0169,0108 ^
+  /win32icon:resources\app.ico /win32manifest:resources\app.manifest ^
+  /out:dist\BunjangAuto.exe !REFS! !RES! ^
+  /r:System.Windows.Forms.dll /r:System.Drawing.dll /r:System.Security.dll ^
+  /r:System.IO.Compression.dll /r:System.IO.Compression.FileSystem.dll /r:System.Core.dll /r:Microsoft.CSharp.dll /r:System.Management.dll ^
+  !SRC!
+echo.
+if exist dist\BunjangAuto.exe (echo 빌드 성공: dist\BunjangAuto.exe) else (echo 빌드 실패)
+:end
+pause
--- 5차/BunjangAuto_v2.0.0/3_소스코드/build.sh
+++ 6차/BunjangAuto_v2.0.0/3_소스코드/build.sh
@@ -0,0 +1,45 @@
+#!/bin/bash
+# Mono 컴파일러(mcs)로 .NET Framework 4.7.2 용 단일 exe 를 만든다. (Windows 에서는 build.bat 사용)
+#   BJA_SERVER_URL=https://logs.example.com BJA_INGEST_KEY=xxxx ./build.sh   ← 중앙 로그 서버 주소/등록키를 exe 에 넣어 빌드
+set -e
+cd "$(dirname "$0")"
+L=lib
+REFS=""
+RES=""
+for f in $L/*.dll; do
+  n=$(basename "$f" .dll)
+  REFS="$REFS -r:$f"
+  RES="$RES -resource:$f,lib.$n.dll"
+done
+# 도움말 문서(오프라인)를 exe 안에 내장
+for f in resources/help/*.md; do
+  [ -f "$f" ] && RES="$RES -resource:$f,help.$(basename "$f")"
+done
+EXTRA=""
+[ -f resources/app.ico ] && EXTRA="$EXTRA -win32icon:resources/app.ico"
+# (mcs 는 -win32manifest 를 지원하지 않아 DPI 설정은 Program.EnableDpiAwareness() 가 대신한다. Windows 의 csc 빌드(build.bat)는 매니페스트를 내장한다)
+DEFS=""
+[ -n "$BJA_DEFINE" ] && DEFS="-define:$BJA_DEFINE"
+
+# 서버 주소/등록키 주입 (환경변수가 없으면 비워 둔다 → telemetry.json 에서 설정)
+cat > src/Telemetry/BuildConfig.cs <<CS
+namespace BunjangAuto
+{
+    // 이 파일은 build.sh / build.bat 가 환경변수(BJA_SERVER_URL, BJA_INGEST_KEY)로 다시 생성한다.
+    public static class BuildConfig
+    {
+        public const string ServerUrl = "${BJA_SERVER_URL:-}";
+        public const string IngestKey = "${BJA_INGEST_KEY:-}";
+    }
+}
+CS
+
+mkdir -p dist
+SRC=$(find src -name '*.cs' | sort)
+mcs -target:winexe -sdk:4.7.2 -optimize+ -langversion:latest -nowarn:1701,1702,0618,0168,0219,0414,0649,0169 $DEFS $EXTRA \
+  -out:dist/BunjangAuto.exe \
+  $REFS $RES \
+  -r:System.Windows.Forms.dll -r:System.Drawing.dll -r:System.Security.dll \
+  -r:System.IO.Compression.dll -r:System.IO.Compression.FileSystem.dll -r:System.Core.dll -r:Microsoft.CSharp.dll -r:System.Management.dll \
+  $SRC
+ls -la dist/BunjangAuto.exe

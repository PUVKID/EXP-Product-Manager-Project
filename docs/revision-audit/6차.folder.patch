+
+namespace BunjangAuto
+{
+    /// <summary>
+    /// 사이트 화면 요소를 찾는 주소(URL)와 XPath 모음.
+    /// 번개장터 화면이 바뀌면 프로그램을 다시 빌드하지 않고
+    /// %AppData%\BunjangAuto\selectors.json 만 고치면 된다.

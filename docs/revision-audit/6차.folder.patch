+
+사용법
+    python server.py init-admin --username admin          # 관리자 계정 생성(비밀번호 입력 프롬프트)
+    python server.py serve --port 8443 --cert c.pem --key k.pem
+    python server.py serve --port 8080                    # 개발/프록시 뒤
+"""

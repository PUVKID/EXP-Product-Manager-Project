+#nav button{width:100%;text-align:left;border:none;background:transparent;padding:9px 12px;border-radius:6px}
+#nav button.on{background:var(--panel2);box-shadow:inset 3px 0 0 var(--accent);font-weight:600}
+.side-foot{margin-top:auto}
+main{padding:20px 28px;min-width:0}
+header{display:flex;justify-content:space-between;align-items:baseline}
+header h2{margin:0 0 14px;font-size:22px}
+.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px;margin-bottom:16px}
+.stat .n{font-size:28px;font-weight:700}
+.stat .l{color:var(--muted);font-size:12px}
+.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(380px,1fr));gap:12px;margin-bottom:12px}
+.card h3{margin:0 0 8px;font-size:14px}

+                if(!choice.Selected)Click(choice.FindElement(By.XPath("ancestor::label[1]")));
+                if(!Require(radio,"반값택배 가능 여부").Selected)
+                    throw new InvalidOperationException("이 상품에 반값택배 설정을 적용할 수 없습니다. 번개장터의 상품 가격·배송 조건을 확인해 주세요.");
+                if(p.HalfShipping){

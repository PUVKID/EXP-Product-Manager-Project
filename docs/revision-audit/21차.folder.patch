+            <para>
+            The maximum possible length <paramref name="smlen"/> is <c>(<paramref name="m"/>.Length +
+            <see cref="F:Org.BouncyCastle.Crypto.Utilities.Lib25519.SignBytes"/>)</c>, so the caller must ensure <paramref name="sm"/> is at least that long.
+            </para>
+            </remarks>
+            <param name="sm">
+            A <c>Span</c> of length at least <c>(<paramref name="m"/>.Length + <see cref="F:Org.BouncyCastle.Crypto.Utilities.Lib25519.SignBytes"/>)</c> to receive
+            the signed message.
+            </param>
+            <param name="smlen">
+            Receives the length of the signed message written to <paramref name="sm"/>.
+            </param>
+            <param name="m">
+            A <c>ReadOnlySpan</c> containing the message to sign.
+            </param>
+            <param name="sk">
+            A <c>ReadOnlySpan</c> of length exactly <see cref="F:Org.BouncyCastle.Crypto.Utilities.Lib25519.SignSecretKeyBytes"/> containing the secret key.
+            </param>
+            <exception cref="T:System.ArgumentException">If any parameter has an invalid length.</exception>
+        </member>

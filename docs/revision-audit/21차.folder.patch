+        </member>
+        <member name="M:Org.BouncyCastle.Crypto.Engines.IdeaEngine.AddInv(System.Int32)">
+            Return the additive inverse of x.
+            <p>
+            i.e. x + AddInv(x) == 0
+            </p>
+        </member>

+
+    /// <summary>
+    /// 엑셀·구글시트·메모장 등 어디서 저장한 CSV 든 글자가 깨지지 않게 읽고,
+    /// 엑셀에서 바로 열리는 CSV(UTF-8 BOM)로 저장한다. 따옴표, 줄바꿈 포함 필드를 지원한다.
+    /// </summary>
+    public static class CsvIO
+    {

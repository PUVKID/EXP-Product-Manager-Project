+        // ============================ 종료 (예전과 동일) ============================
+        private void OnFormClosing(object s, FormClosingEventArgs e)
+        {
+            if (host.Runner.Running &&
+                FluentBox.Show(this, "작업이 진행 중입니다. 종료할까요?", "종료", MessageBoxButtons.YesNo) != DialogResult.Yes)
+            {

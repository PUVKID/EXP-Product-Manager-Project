+             @param trustAnchors
+                        a Set of TrustAnchors
+            
+             @exception InvalidAlgorithmParameterException
+                            if the specified Set is empty
+                            <code>(trustAnchors.isEmpty() == true)</code>
+             @exception NullPointerException

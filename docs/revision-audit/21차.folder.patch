+        <member name="T:Org.BouncyCastle.Asn1.Cms.SignerInfo">
+            <summary>
+            Represents per-signer information within a SignedData
+            </summary>
+            <remarks>
+            See RFC 5652 5.3.
+            <code>
+            SignerInfo ::= SEQUENCE {
+              version CMSVersion,
+              sid SignerIdentifier,

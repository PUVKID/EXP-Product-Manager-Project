+
+namespace BunjangAuto
+{
+    /// <summary>
+    /// 상품 관리. 기존 DataGridView 의 모든 열/편집/CSV 동작을 그대로 두고, 검색·정렬·필터를 보기 전용으로 추가했다.
+    /// 정렬/필터는 화면에만 적용되며 실제 목록(등록 순서)은 바뀌지 않는다.

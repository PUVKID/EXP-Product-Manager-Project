+﻿using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Reflection;
+using System.Threading;
+using System.Windows.Forms;
+
+namespace BunjangAuto
+{
+    static class Program
+    {
+        // exe 안에 내장된 DLL(Selenium 등)을 꺼내 쓰기 위한 처리 → exe 파일 하나만 있으면 실행된다
+        private static readonly Dictionary<string, Assembly> _cache = new Dictionary<string, Assembly>();
+
+        private static Assembly OnResolve(object sender, ResolveEventArgs args)
+        {
+            string simple = new AssemblyName(args.Name).Name;
+            lock (_cache)
+            {
+                Assembly cached;
+                if (_cache.TryGetValue(simple, out cached)) return cached;
+                var self = Assembly.GetExecutingAssembly();
+                string res = "lib." + simple + ".dll";
+                using (Stream s = self.GetManifestResourceStream(res))
+                {
+                    if (s == null) return null;
+                    byte[] data = new byte[s.Length];
+                    int read = 0;
+                    while (read < data.Length) { int n = s.Read(data, read, data.Length - read); if (n <= 0) break; read += n; }
+                    var asm = Assembly.Load(data);
+                    _cache[simple] = asm;
+                    return asm;
+                }
+            }
+        }
+        [System.Runtime.InteropServices.DllImport("user32.dll")] private static extern bool SetProcessDPIAware();
+
+        /// <summary>고DPI(125~200%)에서 흐릿하게 늘어나지 않도록 창을 만들기 전에 DPI 인식을 켠다. (매니페스트와 같은 효과 — 매니페스트가 없는 빌드에서도 동작)</summary>
+        private static void EnableDpiAwareness()
+        {
+            if (Environment.OSVersion.Platform != PlatformID.Win32NT) return;
+            try { SetProcessDPIAware(); }   // 시스템 DPI 인식: WinForms 레이아웃을 가장 예측 가능하게 키울 수 있는 방식
+            catch { }
+        }
+
+        [STAThread]
+        static void Main(string[] args)
+        {
+            EnableDpiAwareness();
+            AppFont.Init();   // 글꼴 객체가 만들어지기 전에 내장 나눔고딕 Bold 를 등록
+            AppDomain.CurrentDomain.AssemblyResolve += OnResolve;
+#if TESTBUILD
+            if (args.Length > 0 && args[0] == "--selftest") { Environment.ExitCode = SelfTest.Run(); return; }
+#endif
+            if (args.Length == 1 && (args[0] == "--activate-for-setup" || args[0] == "--check-for-setup")) { Environment.ExitCode = SetupActivation(args[0] == "--check-for-setup"); return; }
+            RunApp();
+        }
+
+        [System.Runtime.CompilerServices.MethodImpl(System.Runtime.CompilerServices.MethodImplOptions.NoInlining)]
+        static int SetupActivation(bool silent)
+        {
+            try {
+                Application.EnableVisualStyles(); Application.SetCompatibleTextRenderingDefault(false);
+                Paths.EnsureAll(); try { ThemeService.Init(Storage.LoadSettings()); } catch { }
+                if (!(silent ? LicenseGate.Recheck() : LicenseGate.Check())) return 1;
+                UsageQuota.EnsureReady();
+                return Lumivolt.Security.EditionPolicy.SetupCode(LicenseGate.LastInfo.Edition);
+            } catch (Exception ex) { if (!silent) AppDialog.Show(ex.Message,"EXP 인증"); return 1; }
+        }
+
+        // Selenium 등 내장 DLL 을 쓰는 코드는 별도 메서드에 둬서, 리졸버 등록 이후에 JIT 되도록 한다
+        [System.Runtime.CompilerServices.MethodImpl(System.Runtime.CompilerServices.MethodImplOptions.NoInlining)]
+        static void RunApp()
+        {
+            bool created;
+            using (var mutex = new Mutex(true, "BunjangAuto_SingleInstance", out created))
+            {
+                if (!created)
+                {
+                    AppDialog.Show("이미 실행 중입니다.", "EXP", MessageBoxButtons.OK, MessageBoxIcon.Information);   // 아직 아무것도 시작하지 않은 상태라 기본 상자를 쓴다
+                    return;
+                }
+                Application.EnableVisualStyles();
+                Application.SetCompatibleTextRenderingDefault(false);
+                Application.SetUnhandledExceptionMode(UnhandledExceptionMode.CatchException);
+                Paths.EnsureAll();
+                CrashReportService.Install();
+                Log.AppVersion = Brand.Version;
+                // 테마는 첫 화면(약관/라이선스 창)부터 적용한다. 저장된 선택(settings.json)을 읽어 온다.
+                try { ThemeService.Init(Storage.LoadSettings()); } catch { }
+                if (Guard.Suspicious()) { Guard.Die("분석/디버깅 도구가 감지되어 프로그램을 종료합니다.\r\n(저작권자: EXPMASTER)"); return; }
+                if (!TermsGate.Check()) return;
+                if (!LicenseGate.Check()) return;
+                // Recent activity counters are local to this PC.
+                UsageMetricsService.Load();
+                UsageMetricsService.Hook();
+                Log.Write("INFO", "App", "app.start", "프로그램 v" + Brand.Version + " 실행 (" + Environment.OSVersion.VersionString + ")", "OK");
+                Application.ThreadException += (s, e) => CrashReportService.ReportUiException(e.Exception);
+                try { Application.Run(new MainForm()); }
+                finally
+                {
+                    Log.Write("INFO", "App", "app.exit", "프로그램을 종료합니다.", "OK");
+                }
+            }
+        }
+    }
+}
--- 14차/EXP_v2.2.6/3_소스코드/src/Runner.cs
+++ 15차/EXP_v2.2.6/3_소스코드/src/Runner.cs
@@ -0,0 +1,154 @@
+using System;
+using System.Collections.Generic;
+using System.ComponentModel;
+using System.Linq;
+using System.Threading;
+
+namespace BunjangAuto
+{
+    /// <summary>한 번의 실행(로그인 → 등록)을 백그라운드 스레드에서 수행한다.</summary>
+    public class Runner
+    {
+        private Thread _thread;
+        private Bot _bot;
+        private readonly object _gate = new object();
+
+        public bool Running { get; private set; }
+        public string BlockedReason = "";
+        public event Action Finished;
+        public event Action<int, int> Progress;      // (완료, 전체)
+        public event Action<string> ManualLoginNeeded;
+        public Func<string, bool> Ask;
+
+        /// <summary>'1개씩 등록'을 끈 일괄 모드에서 한 번에 등록할 최대 개수</summary>
+        private const int BatchLimit = 30;
+
+        public Bot CurrentBot { get { return _bot; } }
+
+        /// <summary>일시정지 중인지 (v2)</summary>
+        public bool Paused { get { return _bot != null && _bot.PauseRequested; } }
+        /// <summary>지금 등록 중인 상품(화면 표시용)</summary>
+        public volatile Product CurrentProduct;
+
+        public void Pause()
+        {
+            if (_bot != null && Running && !_bot.PauseRequested)
+            {
+                _bot.PauseRequested = true;
+                Log.Write("INFO", "Automation", "run.pause", "[일시정지] 현재 단계가 끝나는 대로 멈춥니다.", "");
+            }
+        }
+
+        public void Resume()
+        {
+            if (_bot != null && _bot.PauseRequested)
+            {
+                _bot.PauseRequested = false;
+                Log.Write("INFO", "Automation", "run.resume", "[일시정지 해제] 이어서 진행합니다.", "");
+            }
+        }
+        /// <summary>이번 실행에서 등록을 시도한 상품(같은 회차 안에서 다음 실행 때 제외하기 위함)</summary>
+        public List<Product> LastRegistered = new List<Product>();
+
+        /// <summary>브라우저를 계속 열어두고 재사용한다(예약 반복 실행 시 로그인 유지).</summary>
+        /// <param name="includeRegistered">true 이면 이미 등록된 상품도 목록 순서대로 다시 등록한다(중복 허용 / 2회차 이후 반복).</param>
+        public void Run(AppSettings cfg, SelectorSet sel, BindingList<Product> products,
+                        Func<IList<Product>> snapshot, Action saveProducts, bool includeRegistered)
+        {
+            Guard.Check();
+            UsageQuota.RequireMode(cfg, includeRegistered);
+            lock (_gate)
+            {
+                if (Running) return;
+                Running = true;
+                BlockedReason = "";
+            }
+            if (_bot == null) _bot = new Bot(cfg, sel);
+            _bot.StopRequested = false;
+            _bot.PauseRequested = false;
+            _bot.Ask = Ask;
+            _bot.NotifyManual = delegate (string m) { var h = ManualLoginNeeded; if (h != null) h(m); };
+
+            var bot = _bot;
+
+            _thread = new Thread(delegate ()
+            {
+                try
+                {
+                    Guard.Check();
+                    Log.Write("===== 작업 시작 =====");
+                    if (!bot.EnsureLogin()) { Log.Write("로그인에 실패해 작업을 중단합니다."); return; }
+
+                    var list = snapshot();
+                    int limit = BatchLimit;
+                    int regLimit = cfg.OneByOne ? 1 : limit;   // 1개씩 등록 모드면 한 번에 1개만
+                    int total = 0, done = 0;
+
+                    var toRegister = new List<Product>();
+                    if (cfg.DoRegister)
+                        toRegister = (includeRegistered
+                            ? list.Where(p => p.IsValid)
+                            : list.Where(p => p.IsValid && string.IsNullOrEmpty(p.ProductId) && p.Status != "등록됨")).Take(regLimit).ToList();
+                    LastRegistered = new List<Product>();
+                    total = toRegister.Count;
+                    Report(0, total);
+
+                    foreach (var p in toRegister)
+                    {
+                        Guard.Check();
+                        p.Status = "진행중";
+                        CurrentProduct = p;
+                        LastRegistered.Add(p);
+                        bot.Register(p);
+                        CurrentProduct = null;
+                        if (p.Status == "등록됨")
+                        {
+                            // 등록이 끝까지 성공했다는 것은 이미지 업로드/카테고리 선택도 성공했다는 뜻이므로 구조화 이벤트만 추가로 남긴다
+                            if (!string.IsNullOrWhiteSpace(p.Images)) Log.Write("DEBUG", "ProductUpload", "image.upload.success", "  이미지 업로드 확인", "OK");
+                            if (!string.IsNullOrWhiteSpace(p.Category)) Log.Write("DEBUG", "Category", "category.success", "  카테고리 처리 확인: " + p.Category, "OK");
+                        }
+                        saveProducts();
+                        Report(++done, total);
+                        bot.HumanPause();
+                    }
+
+                    Log.Write("===== 작업 완료 =====");
+                }
+                catch (StopRequestedException) { CurrentProduct = null; Log.Write("사용자가 작업을 중지했습니다."); }
+                catch (Exception ex)
+                {
+                    if (ex is RegistrationBlockedException) BlockedReason = ex.Message;
+                    CurrentProduct = null;
+                    Log.Error("Automation", "run.error", "오류: " + ex.Message, ex);
+                    try { if (!bot.IsAlive) bot.Close(); } catch { }
+                }
+                finally
+                {
+                    try { saveProducts(); } catch { }
+                    lock (_gate) { Running = false; }
+                    var h = Finished; if (h != null) h();
+                }
+            });
+            _thread.IsBackground = true;
+            _thread.SetApartmentState(ApartmentState.MTA);
+            _thread.Start();
+        }
+
+        private void Report(int done, int total)
+        {
+            var h = Progress; if (h != null) h(done, total);
+        }
+
+        public void Stop()
+        {
+            if (_bot != null) _bot.StopRequested = true;
+        }
+
+        public void Shutdown()
+        {
+            Stop();
+            try { if (_thread != null && _thread.IsAlive) _thread.Join(3000); } catch { }
+            if (_bot != null) { _bot.Close(); _bot = null; }
+        }
+    }
+}
--- 14차/EXP_v2.2.6/3_소스코드/src/Schedule.cs
+++ 15차/EXP_v2.2.6/3_소스코드/src/Schedule.cs
@@ -0,0 +1,151 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text;
+
+namespace BunjangAuto
+{
+    /// <summary>
+    /// 시간대 한 줄. "시작 ~ 종료 사이에는 Minutes 분마다 1개씩 등록".
+    /// 종료가 시작보다 이르면 자정을 넘기는 시간대(예: 22:00~06:00), 같으면 24시간 내내로 본다.
+    /// </summary>
+    public class TimeRule
+    {
+        public string Start { get; set; }
+        public string End { get; set; }
+        public int Minutes { get; set; }
+
+        public TimeRule() { Start = "00:00"; End = "09:00"; Minutes = 40; }
+        public TimeRule(string start, string end, int minutes) { Start = start; End = end; Minutes = minutes; }
+    }
+
+    /// <summary>검사가 끝난 시간대(분 단위).</summary>
+    public class TimeWindow
+    {
+        public int Start;     // 0 ~ 1439
+        public int End;       // 0 ~ 1440
+        public int Minutes;   // 등록 간격(분)
+
+        public bool Contains(double minuteOfDay)
+        {
+            if (Start == End) return true;                       // 24시간
+            if (Start < End) return minuteOfDay >= Start && minuteOfDay < End;
+            return minuteOfDay >= Start || minuteOfDay < End;    // 자정을 넘김
+        }
+
+        public override string ToString()
+        {
+            return Schedule.Format(Start) + "~" + Schedule.Format(End) + " " + Minutes + "분마다 1개";
+        }
+    }
+
+    public static class Schedule
+    {
+        /// <summary>"9", "9:30", "09:30", "24:00" 형태를 분으로 바꾼다.</summary>
+        public static bool TryParseTime(string s, out int minutes)
+        {
+            minutes = 0;
+            if (string.IsNullOrWhiteSpace(s)) return false;
+            s = s.Trim().Replace('：', ':').Replace('.', ':');
+            string[] parts = s.Split(':');
+            int h, m = 0;
+            if (parts.Length == 1)
+            {
+                if (!int.TryParse(parts[0], out h)) return false;
+            }
+            else if (parts.Length == 2)
+            {
+                if (!int.TryParse(parts[0], out h) || !int.TryParse(parts[1], out m)) return false;
+            }
+            else return false;
+            if (h < 0 || h > 24 || m < 0 || m > 59) return false;
+            if (h == 24 && m != 0) return false;
+            minutes = h * 60 + m;
+            return true;
+        }
+
+        public static string Format(int minutes)
+        {
+            return (minutes / 60).ToString("00") + ":" + (minutes % 60).ToString("00");
+        }
+
+        /// <summary>화면에서 입력한 시간대 목록을 검사해 계산용 목록으로 바꾼다. 문제가 있으면 false 와 안내 문구.</summary>
+        public static bool TryBuild(IList<TimeRule> rules, out List<TimeWindow> wins, out string error)
+        {
+            wins = new List<TimeWindow>();
+            error = null;
+            if (rules == null || rules.Count == 0)
+            {
+                error = "시간대가 하나도 없습니다. [시간대 추가]를 눌러 시간대를 넣어 주세요.";
+                return false;
+            }
+            for (int i = 0; i < rules.Count; i++)
+            {
+                var r = rules[i];
+                string no = (i + 1) + "번째 시간대: ";
+                int s, e;
+                if (!TryParseTime(r.Start, out s) || s >= 1440)
+                { error = no + "시작 시각을 'HH:mm' 형태로 넣어 주세요. (예: 00:00)"; return false; }
+                if (!TryParseTime(r.End, out e))
+                { error = no + "종료 시각을 'HH:mm' 형태로 넣어 주세요. (예: 09:00, 하루 끝은 24:00)"; return false; }
+                if (r.Minutes < 1 || r.Minutes > 1440)
+                { error = no + "간격은 1~1440분 사이로 넣어 주세요."; return false; }
+                wins.Add(new TimeWindow { Start = s, End = e, Minutes = r.Minutes });
+            }
+            return true;
+        }
+
+        public static TimeWindow ActiveAt(IList<TimeWindow> wins, DateTime t)
+        {
+            double m = t.TimeOfDay.TotalMinutes;
+            // For overlapping rules, the most recently started window takes priority.
+            TimeWindow best = null; DateTime latest = DateTime.MinValue;
+            foreach (var w in wins) if (w.Contains(m)) {
+                DateTime start = t.Date.AddMinutes(w.Start); if (start > t) start = start.AddDays(-1);
+                if (start > latest) { latest = start; best = w; }
+            }
+            return best;
+        }
+
+        /// <summary>t 가 어떤 시간대 안이면 t, 아니면 그 이후 가장 가까운 시간대 시작 시각.</summary>
+        public static DateTime NextAllowed(IList<TimeWindow> wins, DateTime t)
+        {
+            if (ActiveAt(wins, t) != null) return t;
+            DateTime best = DateTime.MaxValue;
+            foreach (var w in wins)
+            {
+                for (int d = 0; d <= 1; d++)
+                {
+                    DateTime s = t.Date.AddDays(d).AddMinutes(w.Start);
+                    if (s >= t && s < best) best = s;
+                }
+            }
+            return best;
+        }
+
+        /// <summary>
+        /// 직전 등록을 시작한 시각(lastStart)을 기준으로 다음 등록 시각을 구한다.
+        /// 직전 시각이 속한 시간대의 간격만큼 뒤로 잡고, 그 시각이 시간대 밖이면 다음 시간대가 시작될 때까지 기다린다.
+        /// </summary>
+        public static DateTime NextRun(IList<TimeWindow> wins, DateTime lastStart, DateTime now, int fallbackMinutes)
+        {
+            var w = ActiveAt(wins, lastStart);
+            int gap = w != null ? w.Minutes : fallbackMinutes;
+            DateTime candidate = lastStart.AddMinutes(gap);
+            // A new reservation window cancels the previous window's remaining delay,
+            // including adjacent windows, gaps, overlaps and midnight boundaries.
+            foreach (var rule in wins) for (int d = 0; d <= 2; d++) {
+                DateTime start = lastStart.Date.AddDays(d).AddMinutes(rule.Start);
+                if (start > lastStart && start < candidate) candidate = start;
+            }
+            DateTime cand = NextAllowed(wins, candidate);
+            if (cand < now) cand = NextAllowed(wins, now);
+            return cand;
+        }
+
+        public static string Describe(IList<TimeWindow> wins)
+        {
+            return string.Join(" / ", wins.Select(w => w.ToString()).ToArray());
+        }
+    }
+}

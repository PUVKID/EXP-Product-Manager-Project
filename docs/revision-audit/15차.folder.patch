+            var key = Load(directory); var pub = key.GeneratePublicKey().GetEncoded();
+            var o = new JObject { { "version", 4 }, { "edition", edition }, { "licenseId", Guid.NewGuid().ToString("D") }, { "product", "EXP" }, { "name", name.Trim() }, { "issuedUtc", LicenseProtocol.Utc(DateTime.UtcNow) }, { "expiresUtc", expires.HasValue ? (JToken)LicenseProtocol.Utc(expires.Value) : JValue.CreateNull() }, { "perpetual", !expires.HasValue }, { "features", new JArray("automation") }, { "devicePublicKey", req["devicePublicKey"].DeepClone() }, { "keyId", LicenseProtocol.KeyId(pub) }, { "status", "active" } };
+            o["trial"] = trial;
+            byte[] data = LicenseProtocol.Bytes(o);
+            var signer = new Ed25519Signer(); signer.Init(true, key); signer.BlockUpdate(data, 0, data.Length);
+            string token = LicenseProtocol.Wrap("LV4", data, signer.GenerateSignature());

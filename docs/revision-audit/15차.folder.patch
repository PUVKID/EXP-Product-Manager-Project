+using System;
+using System.IO;
+using System.Windows.Forms;
+using Lumivolt.Security;
+namespace BunjangAuto
+{
+    public static class LicenseFiles
+    {
+        public static bool CopyRequest(out string request, out string message)
+        {
+            request = "";
+            try { request = TpmDevice.CreateRequest(); }
+            catch (Exception ex) { message = TpmDevice.Error(ex); return false; }
+            try { Clipboard.SetText(request); message = "복사했습니다. 판매자에게 붙여 넣어 보내세요."; return true; }
+            catch { message = "자동 복사에 실패했습니다. 표시된 등록코드를 직접 복사해 주세요."; return false; }
+        }
+        public static string PasteKey()
+        {
+            return LicenseText.Normalize(Clipboard.GetText(), "LV3");
+        }
+        public static void ExportRequest(IWin32Window owner)
+        {
+            using (var d = new SaveFileDialog { Filter = "EXP 등록코드|*.lvrequest", FileName = "EXP-등록코드.lvrequest" })
+            {
+                if (d.ShowDialog(owner) != DialogResult.OK) return;
+                try { File.WriteAllText(d.FileName, TpmDevice.CreateRequest(), LicenseProtocol.Utf8); FluentBox.Show(owner, "등록 요청 파일을 저장했습니다. 관리자에게 전달해 주세요.", "라이선스"); }
+                catch (Exception ex) { FluentBox.Show(owner, ex is System.Security.Cryptography.CryptographicException ? TpmDevice.Error(ex) : "등록 요청을 저장하지 못했습니다. 저장 위치와 TPM 상태를 확인해 주세요.", "라이선스"); }
+            }
+        }
+        public static string ImportLicense(IWin32Window owner)
+        {
+            using (var d = new OpenFileDialog { Filter = "EXP 인증키|*.lvlicense;*.expkey|텍스트 파일|*.txt" })
+            {
+                if (d.ShowDialog(owner) != DialogResult.OK) return null;
+                try { return LicenseProtocol.ReadFile(d.FileName).Trim(); }
+                catch { FluentBox.Show(owner, "라이선스 파일을 읽을 수 없습니다.", "라이선스"); return null; }
+            }
+        }
+    }
+}
--- 14차/EXP_v2.2.6/3_소스코드/src/Security/TpmDevice.cs
+++ 15차/EXP_v2.2.6/3_소스코드/src/Security/TpmDevice.cs
@@ -0,0 +1,73 @@
+using System;
+using System.Security.Cryptography;
+using Newtonsoft.Json.Linq;
+using Lumivolt.Security;
+
+namespace BunjangAuto
+{
+    public static class TpmDevice
+    {
+        public const string KeyName = "Lumivolt.Device.v3";
+        static readonly CngProvider Provider = new CngProvider("Microsoft Platform Crypto Provider");
+        static readonly object Gate = new object();
+        internal static CngKey Open(bool create)
+        {
+            lock (Gate)
+            {
+                try { var k = CngKey.Open(KeyName, Provider); Validate(k); return k; }
+                catch (CryptographicException ex)
+                {
+                    uint code = unchecked((uint)ex.HResult);
+                    if (!create || (code != 0x80090016 && code != 0x80090011)) throw;
+                }
+                var p = new CngKeyCreationParameters { Provider = Provider, ExportPolicy = CngExportPolicies.None, KeyUsage = CngKeyUsages.Signing };
+                var key = CngKey.Create(CngAlgorithm.ECDsaP256, KeyName, p);
+                Validate(key); return key;
+            }
+        }
+        static void Validate(CngKey k)
+        {
+            // Some Platform KSP versions report generic ECDSA rather than ECDSA_P256.
+            // Validate group AND the exact exported P-256 public blob, never the alias alone.
+            if (k.Provider.Provider != Provider.Provider || k.AlgorithmGroup != CngAlgorithmGroup.ECDsa || k.ExportPolicy != CngExportPolicies.None || k.IsEphemeral)
+            { k.Dispose(); throw new CryptographicException("TPM 비이동형 키 정책이 일치하지 않습니다."); }
+            LicenseProtocol.PublicBlob(Convert.ToBase64String(k.Export(CngKeyBlobFormat.EccPublicBlob)));
+        }

+        internal static string Issue(string directory, string request, string name, DateTime? expires, string edition, bool trial)
+        {
+            if (String.IsNullOrWhiteSpace(name) || name.Trim().Length > 120) throw new FormatException("이름/메모를 1~120자로 입력해 주세요.");

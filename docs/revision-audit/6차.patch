+            switch (prop)
+            {
+                case "Price": return p => { long v; return long.TryParse(p.Price, out v) ? (object)v : 0L; };
+                case "Quantity": return p => { long v; return long.TryParse(p.Quantity, out v) ? (object)v : 0L; };

+                        FluentBox.Show(owner, "기존 목록을 지우고 새로 불러올까요?\r\n(아니오: 아래에 이어서 추가)", "CSV 불러오기", MessageBoxButtons.YesNo, MessageBoxIcon.Question) == DialogResult.Yes;
+                    if (replace) Host.Products.Clear();

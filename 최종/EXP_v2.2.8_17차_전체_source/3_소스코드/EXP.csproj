<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows SDK project. Verified build path: build/Build.ps1 using the Windows .NET Framework compiler. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>EXP</AssemblyName>
    <RootNamespace>BunjangAuto</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationIcon>resources\app.ico</ApplicationIcon>
    <ApplicationManifest>resources\app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>disable</Nullable>
    <NoWarn>1701;1702;0618;0168;0219;0414;0649;0169;0108</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Compile Include="shared\*.cs" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <!-- lib\*.dll: 컴파일 참조 + exe 안에 'lib.<이름>.dll' 로 내장 (Program.cs 의 AssemblyResolve 가 꺼내 쓴다. 단일 exe 유지) -->
  <ItemGroup>
    <LibDll Include="lib\*.dll" />
    <Reference Include="%(LibDll.Filename)"><HintPath>%(LibDll.Identity)</HintPath><Private>false</Private></Reference>
    <EmbeddedResource Include="@(LibDll)" LogicalName="lib.%(Filename)%(Extension)" />
    <EmbeddedResource Include="resources\app.ico" LogicalName="brand.app.ico" />
    <EmbeddedResource Include="resources\fonts\NanumGothicBold.ttf" LogicalName="font.NanumGothicBold.ttf" />
    <EmbeddedResource Include="resources\help\*.md" LogicalName="help.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
